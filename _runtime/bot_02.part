                self._sticker_cache[custom_emoji_id] = file_id
            return self.call("sendSticker", chat_id=chat, sticker=file_id)
        except Exception:
            logging.info("Premium sticker unavailable; skipped.")
            return None


class Bot:
    def __init__(self, api, config, database, admin):
        self.api, self.config, self.admin = api, config, admin
        self.db = sqlite3.connect(database)
        self.db.row_factory = sqlite3.Row
        self.db.executescript("""
            CREATE TABLE IF NOT EXISTS sessions(
                chat INTEGER PRIMARY KEY,
                data TEXT NOT NULL,
                updated INTEGER NOT NULL DEFAULT 0
            );
            CREATE TABLE IF NOT EXISTS ui_state(
                chat INTEGER PRIMARY KEY,
                message_id INTEGER,
                keyboard_installed INTEGER NOT NULL DEFAULT 0,
                updated INTEGER NOT NULL DEFAULT 0
            );
            CREATE TABLE IF NOT EXISTS bookings(
                id INTEGER PRIMARY KEY,
                chat INTEGER,
                data TEXT NOT NULL,
                created TEXT DEFAULT CURRENT_TIMESTAMP,
                notified INTEGER DEFAULT 0,
                status TEXT NOT NULL DEFAULT 'new'
            );
            CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value INTEGER);
            CREATE TABLE IF NOT EXISTS deliveries(booking INTEGER, part INTEGER, PRIMARY KEY(booking, part));
        """)
        self._migrate_schema()
        self.panel = AdminPanel(self)
        self._last_janitor = 0

    def _migrate_schema(self):
        session_columns = {r[1] for r in self.db.execute("PRAGMA table_info(sessions)")}
        if "updated" not in session_columns:
            self.db.execute("ALTER TABLE sessions ADD COLUMN updated INTEGER NOT NULL DEFAULT 0")
            self.db.execute("UPDATE sessions SET updated=? WHERE updated=0", (int(time.time()),))

        columns = {r[1] for r in self.db.execute("PRAGMA table_info(bookings)")}
        migrations = {
            "status": "ALTER TABLE bookings ADD COLUMN status TEXT NOT NULL DEFAULT 'new'",
            # Never mark legacy rows as paid automatically. Payment must be proven by successful_payment.
            "payment_status": "ALTER TABLE bookings ADD COLUMN payment_status TEXT NOT NULL DEFAULT 'legacy'",
            "payment_payload": "ALTER TABLE bookings ADD COLUMN payment_payload TEXT",
            "amount": "ALTER TABLE bookings ADD COLUMN amount INTEGER",
            "currency": "ALTER TABLE bookings ADD COLUMN currency TEXT DEFAULT 'RUB'",
            "telegram_charge_id": "ALTER TABLE bookings ADD COLUMN telegram_charge_id TEXT",
            "provider_charge_id": "ALTER TABLE bookings ADD COLUMN provider_charge_id TEXT",
            "invoice_created": "ALTER TABLE bookings ADD COLUMN invoice_created INTEGER",
            "payment_url": "ALTER TABLE bookings ADD COLUMN payment_url TEXT",
            "anonymized": "ALTER TABLE bookings ADD COLUMN anonymized INTEGER NOT NULL DEFAULT 0",
        }
        for name, sql in migrations.items():
            if name not in columns:
                self.db.execute(sql)

        # Version 10 accidentally added payment_status with DEFAULT 'paid'. Repair rows
        # that have no Telegram charge proof instead of treating them as real payments.
        final_columns = {r[1] for r in self.db.execute("PRAGMA table_info(bookings)")}
        if "payment_status" in final_columns and "telegram_charge_id" in final_columns:
            self.db.execute(
                "UPDATE bookings SET payment_status='legacy' "
                "WHERE payment_status='paid' AND COALESCE(telegram_charge_id,'')=''"
            )
        self.db.commit()

    @property
    def emoji(self):
        return self.config.get("ui", {}).get("custom_emoji", {})

    @property
    def stickers(self):
        return self.config.get("ui", {}).get("premium_stickers", {})

    def e(self, key):
        return self.emoji.get(key) or None

    def session(self, chat):
        row = self.db.execute("SELECT data FROM sessions WHERE chat=?", (chat,)).fetchone()
        data = json.loads(row[0]) if row else {}
        return data if data.get("pricing_version") == PRICING_VERSION else {}

    def save(self, chat, data):
        with self.db:
            self.db.execute(
                "INSERT OR REPLACE INTO sessions(chat,data,updated) VALUES (?,?,?)",
                (chat, json.dumps(data, ensure_ascii=False), int(time.time())),
            )

    def clear(self, chat):
        # Cancelling a draft also invalidates any still-unpaid payment link tied to it.
        row = self.db.execute("SELECT data FROM sessions WHERE chat=?", (chat,)).fetchone()
        if row:
            try:
                data = json.loads(row[0])
                booking_id = data.get("booking_id")
            except Exception:
                booking_id = None
            if booking_id:
                with self.db:
                    self.db.execute(
                        "UPDATE bookings SET payment_status='expired',status='expired' WHERE id=? AND chat=? AND payment_status='pending'",
                        (booking_id, chat),
                    )
        with self.db:
            self.db.execute("DELETE FROM sessions WHERE chat=?", (chat,))

    def ui(self, chat):
        row = self.db.execute("SELECT * FROM ui_state WHERE chat=?", (chat,)).fetchone()
        return dict(row) if row else {}

    def save_ui(self, chat, message_id=None, keyboard_installed=None):
        old = self.ui(chat)
        if message_id is None:
            message_id = old.get("message_id")
        if keyboard_installed is None:
            keyboard_installed = old.get("keyboard_installed", 0)
        with self.db:
            self.db.execute(
                "INSERT OR REPLACE INTO ui_state(chat,message_id,keyboard_installed,updated) VALUES (?,?,?,?)",
                (chat, message_id, int(bool(keyboard_installed)), int(time.time())),
            )

    @staticmethod
    def _editable_error(error):
        text = str(error).lower()
        return any(part in text for part in (
            "message to edit not found", "message can't be edited", "message can not be edited",
            "message_id_invalid", "message identifier is not specified",
        ))

    def render(self, chat, text, buttons, *, message_id=None):
        """Render customer UI into one persistent message."""
        state = self.ui(chat)
        target = message_id or state.get("message_id")
        if target:
            try:
                self.api.edit(chat, target, text, buttons)
                self.save_ui(chat, target, True)
                return target
            except Exception as error:
                if not self._editable_error(error):
                    raise
                logging.info("Main UI message for chat %s is unavailable; recreating it.", chat)

        # First screen installs a persistent bottom keyboard, then the same message is
        # converted to inline UI. Telegram keeps the reply keyboard visible.
        if hasattr(self.api, "send_with_bottom_keyboard"):
            sent = self.api.send_with_bottom_keyboard(chat, "✨ Открываю DEZ REMKA…", chat == self.admin)
            new_id = (sent or {}).get("message_id") if isinstance(sent, dict) else None
            if new_id:
                self.save_ui(chat, new_id, True)
                try:
                    self.api.edit(chat, new_id, text, buttons)
                    return new_id
