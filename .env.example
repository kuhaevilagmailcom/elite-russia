APP_NAME=MINION MARKET
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000
BIND_HOST=0.0.0.0

# Telegram. BOT_TOKEN/BOT_USERNAME are supported aliases.
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BUSINESS_CONNECTION_ID=
TELEGRAM_CUSTODY_CONNECTION_ID=
TELEGRAM_CUSTODY_USERNAME=
TELEGRAM_CUSTODY_USER_ID=
TELEGRAM_CUSTODY_OWNER_ID=
OWNER_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=
ADMIN_IDS=
ADMIN_ROLES_JSON=

# TON / GRAM. Keep live flags false until external audit and reconciliation.
TON_NETWORK=testnet
TON_API_KEY=
TON_RPC_URL=
TON_TREASURY_ADDRESS=
TON_SIGNER_ENDPOINT=
TONCONNECT_MANIFEST_URL=
MARKET_CURRENCY=GRAM

# Storage. SQLite is an isolated local sandbox; PostgreSQL is required for release.
DATABASE_DRIVER=sqlite
DATABASE_URL=
DATABASE_PATH=./data/minion.sqlite
DB_PATH=./data/minion.sqlite
# BotHost supplies DATA_DIR=/app/data automatically. When BOT_ID/DATA_DIR is
# present and DB_PATH is unset, the app uses /app/data/minion.sqlite.
REDIS_URL=
SESSION_SECRET=
ENCRYPTION_KEY=

MARKET_ENABLED=true
OFFERS_ENABLED=true
COLLECTION_OFFERS_ENABLED=true
QUICK_SELL_ENABLED=true
BUNDLES_ENABLED=true
SWEEP_ENABLED=true
SWAP_ENABLED=true
GIVEAWAYS_ENABLED=true
LIVE_FINANCE_ENABLED=false
LIVE_CUSTODY_ENABLED=false
TESTNET_DEPOSITS_ENABLED=false
LIVE_DEPOSITS_ENABLED=false
LIVE_WITHDRAWALS_ENABLED=false
CUSTODY_ENABLED=false
GIFT_DEPOSITS_ENABLED=false
GIFT_WITHDRAWALS_ENABLED=false

SUPPORT_USERNAME=
NEWS_CHANNEL=
