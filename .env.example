# Configure both tokens as private BotHost environment variables. Never commit real values.
BOT_TOKEN=
# MRKT session token captured by MRKT Scout after your own Telegram login.
MRKT_API_TOKEN=
# Legacy alias is still accepted: MRKT_TOKEN=
MRKT_AUTH_MODE=auto
MRKT_POLL_SECONDS=120
MRKT_PAGES=3
MRKT_WATCH_TYPES=both
MRKT_MAX_PAID_TON=0
# Send up to five currently active giveaways on the first successful scan.
MRKT_NOTIFY_EXISTING=true
MRKT_INITIAL_LIMIT=5
DATABASE_PATH=data/gifts.db

# Existing Mini App settings remain optional.
PUBLIC_URL=https://bot-1790259314-9532-furadev.bothost.tech
ADMIN_IDS=
ALLOW_DEMO_DATA=false
EMOJI_GIFT_ID=
EMOJI_OWNER_ID=
EMOJI_MODEL_ID=
EMOJI_PRICE_ID=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
RESALE_SYNC_MINUTES=15
